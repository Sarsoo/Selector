{
    "compileOnSave": true,
    "compilerOptions": {
        "strict": true,
        "sourceMap": true,
        "noImplicitAny": true,
        "noEmitOnError": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "module": "es6",
        "target": "es6",
        "allowJs": true,
        "moduleResolution": "bundler",
        "outDir": "./wwwroot/js",
        "baseUrl": "."
    },
    "include": ["scripts/**/*.ts", "scripts/**/*.tsx", "scripts/**/*.vue"]
}